{
  // Node 24 for THIS workspace only; the machine-wide `node` stays untouched.
  // ~/.zprofile (login shells) re-prepends Homebrew's default node, so this
  // workspace's terminals start as interactive NON-login shells.
  // node_modules/.bin comes first so `nest`, `prisma`, etc. use this project's
  // versions, not the global ones (global @nestjs/cli is v11, kept for other projects).
  "terminal.integrated.env.osx": {
    "PATH": "${workspaceFolder}/node_modules/.bin:/opt/homebrew/opt/node@24/bin:${env:PATH}"
  },
  "terminal.integrated.profiles.osx": {
    "zsh (Node 24)": {
      "path": "/bin/zsh",
      "args": ["-i"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "zsh (Node 24)"
}
